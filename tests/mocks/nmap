#!/usr/bin/env bash
# Deterministic nmap stand-in for tests: ignores real scanning, prints one
# canned open-port line, and (if CYBERAUTO_NMAP_ARGS_LOG is set) records the
# arguments it was called with so tests can assert on the flags a mode used.
if [ -n "${CYBERAUTO_NMAP_ARGS_LOG:-}" ]; then
  echo "$*" >> "$CYBERAUTO_NMAP_ARGS_LOG"
fi

cat <<'EOF'
Starting Nmap 7.94 ( https://nmap.org )
Nmap scan report for target
Host is up.

PORT   STATE SERVICE
22/tcp open  ssh
| vulners:
|   cpe:/a:openbsd:openssh:8.2:
|_      CVE-2020-14145  5.9  https://vulners.com/cve/CVE-2020-14145

Nmap done: 1 IP address (1 host up) scanned in 0.01 seconds
EOF
