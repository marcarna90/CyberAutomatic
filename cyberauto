#!/usr/bin/env bash
# cyberauto — CyberAutomatic entrypoint: arg parsing + scope-gated dispatch.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/deps.sh
source "${SCRIPT_DIR}/lib/deps.sh"
# shellcheck source=lib/scope.sh
source "${SCRIPT_DIR}/lib/scope.sh"
# shellcheck source=lib/workspace.sh
source "${SCRIPT_DIR}/lib/workspace.sh"
# shellcheck source=lib/findings.sh
source "${SCRIPT_DIR}/lib/findings.sh"
# shellcheck source=lib/report.sh
source "${SCRIPT_DIR}/lib/report.sh"

TARGET=""
TARGET_FILE=""
MODE=""
WORKSPACE_ALIAS=""
CONFIG_PATH=""
AUTHORIZED=0
ALLOW_BRUTEFORCE=0
DO_LIST=0
DO_DELETE=0
EXPORT_DEST=""
REIMPORT_SRC=""
REPORT_DEST=""
MODES_DIR_OVERRIDE=""
WORKSPACE_DIR_OVERRIDE=""
EXTRA_OPTS=""
DO_RERUN=0

while [ $# -gt 0 ]; do
  case "$1" in
    -t|--target) TARGET="$2"; shift 2 ;;
    -f|--target-file) TARGET_FILE="$2"; shift 2 ;;
    -m|--mode) MODE="$2"; shift 2 ;;
    -w|--workspace) WORKSPACE_ALIAS="$2"; shift 2 ;;
    -c|--config) CONFIG_PATH="$2"; shift 2 ;;
    --i-am-authorized) AUTHORIZED=1; shift ;;
    --allow-bruteforce) ALLOW_BRUTEFORCE=1; shift ;;
    --rerun) DO_RERUN=1; shift ;;
    --list) DO_LIST=1; shift ;;
    -d|--delete) DO_DELETE=1; shift ;;
    --export) EXPORT_DEST="$2"; shift 2 ;;
    --reimport) REIMPORT_SRC="$2"; shift 2 ;;
    --report) REPORT_DEST="$2"; shift 2 ;;
    --modes-dir) MODES_DIR_OVERRIDE="$2"; shift 2 ;;
    --workspace-dir) WORKSPACE_DIR_OVERRIDE="$2"; shift 2 ;;
    --)
      shift
      EXTRA_OPTS="$*"
      break
      ;;
    *)
      echo "ERROR: unknown argument '$1'" >&2
      exit 1
      ;;
  esac
done

# Resolve config: explicit -c, else ./cyberauto.conf next to this script,
# else the shipped example (so a fresh checkout still runs).
if [ -z "$CONFIG_PATH" ]; then
  if [ -f "${SCRIPT_DIR}/cyberauto.conf" ]; then
    CONFIG_PATH="${SCRIPT_DIR}/cyberauto.conf"
  else
    CONFIG_PATH="${SCRIPT_DIR}/conf/cyberauto.conf.example"
  fi
fi
# shellcheck disable=SC1090
source "$CONFIG_PATH"

MODES_DIR="${MODES_DIR_OVERRIDE:-${SCRIPT_DIR}/modes}"
WORKSPACE_DIR="${WORKSPACE_DIR_OVERRIDE:-${CYBERAUTO_WORKSPACE_DIR:-${SCRIPT_DIR}/workspaces}}"

if [ "$DO_LIST" -eq 1 ]; then
  workspace::list "$WORKSPACE_DIR"
  exit 0
fi

if [ "$DO_DELETE" -eq 1 ]; then
  workspace::delete "$WORKSPACE_ALIAS" "$WORKSPACE_DIR"
  exit $?
fi

if [ -n "$EXPORT_DEST" ]; then
  workspace::export "$WORKSPACE_ALIAS" "$WORKSPACE_DIR" "$EXPORT_DEST"
  exit $?
fi

if [ -n "$REIMPORT_SRC" ]; then
  workspace::reimport "$REIMPORT_SRC" "$WORKSPACE_DIR"
  exit $?
fi

if [ -n "$REPORT_DEST" ]; then
  REPORT_WORKSPACE_PATH=$(workspace::create "$WORKSPACE_ALIAS" "$WORKSPACE_DIR")
  report::generate "$REPORT_WORKSPACE_PATH" "${SCRIPT_DIR}/templates/report.md.tpl" \
    "${SCRIPT_DIR}/templates/finding_row.md.tpl" "$REPORT_DEST"
  exit $?
fi

# Main scan flow below requires a workspace, and either a mode (normal run)
# or --rerun (repeats the last recorded run for that workspace).
if [ -z "$WORKSPACE_ALIAS" ]; then
  echo "ERROR: -w/--workspace is required" >&2
  exit 1
fi

WORKSPACE_PATH=$(workspace::create "$WORKSPACE_ALIAS" "$WORKSPACE_DIR")

if [ "$DO_RERUN" -eq 1 ]; then
  MODE=$(workspace::last "$WORKSPACE_PATH" mode)
  if [ -z "$MODE" ]; then
    echo "ERROR: no previous run recorded for workspace '${WORKSPACE_ALIAS}'" >&2
    exit 1
  fi
  LAST_IS_FILE=$(workspace::last "$WORKSPACE_PATH" is_file)
  LAST_TARGET=$(workspace::last "$WORKSPACE_PATH" target)
  EXTRA_OPTS=$(workspace::last "$WORKSPACE_PATH" opts)
  if [ "$LAST_IS_FILE" = "1" ]; then
    TARGET_FILE="$LAST_TARGET"
    TARGET=""
  else
    TARGET="$LAST_TARGET"
    TARGET_FILE=""
  fi
elif [ -z "$MODE" ]; then
  echo "ERROR: -m/--mode is required (or pass --rerun)" >&2
  exit 1
fi

if [ "$MODE" = "bruteforce" ] && [ "$ALLOW_BRUTEFORCE" -ne 1 ]; then
  echo "ERROR: bruteforce mode requires --allow-bruteforce" >&2
  exit 1
fi

if [ "$DO_RERUN" -ne 1 ]; then
  if [ -n "$TARGET" ] && [ -n "$TARGET_FILE" ]; then
    echo "ERROR: provide either -t/--target or -f/--target-file, not both" >&2
    exit 1
  fi
  if [ -z "$TARGET" ] && [ -z "$TARGET_FILE" ]; then
    echo "ERROR: provide one of -t/--target or -f/--target-file" >&2
    exit 1
  fi
fi

# Scope guard: every target (a single -t host, or every line of a -f file)
# must pass scope::check before any mode is dispatched — a batch with one
# out-of-scope line refuses the whole run rather than silently skipping it.
if [ -n "$TARGET_FILE" ]; then
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if ! scope::check "$line" "${CYBERAUTO_ALLOWED_TARGETS:-}" "$AUTHORIZED"; then
      exit 1
    fi
  done < "$TARGET_FILE"
  DISPATCH_TARGET="$TARGET_FILE"
else
  if ! scope::check "$TARGET" "${CYBERAUTO_ALLOWED_TARGETS:-}" "$AUTHORIZED"; then
    exit 1
  fi
  DISPATCH_TARGET="$TARGET"
fi

if [ -n "$TARGET_FILE" ]; then
  workspace::record_last "$WORKSPACE_PATH" "$MODE" "$TARGET_FILE" "1" "$EXTRA_OPTS"
else
  workspace::record_last "$WORKSPACE_PATH" "$MODE" "$TARGET" "0" "$EXTRA_OPTS"
fi

MODE_FILE="${MODES_DIR}/${MODE}.sh"
if [ ! -f "$MODE_FILE" ]; then
  echo "ERROR: unknown mode '${MODE}'" >&2
  exit 2
fi

# shellcheck disable=SC1090
source "$MODE_FILE"
MODE_FUNC="mode_${MODE}_run"
"$MODE_FUNC" "$DISPATCH_TARGET" "$WORKSPACE_PATH" "$EXTRA_OPTS"
exit $?
